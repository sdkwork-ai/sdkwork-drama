# sdkwork-drama standalone.production profile
# Deployment-specific values (bind, database) are injected by the deployment
# environment; secrets come from a secret manager, never from this file.
# Only variables actually consumed by the process are listed.

SDKWORK_ENV=production
SDKWORK_ENVIRONMENT=production

SDKWORK_CORS_ALLOWED_ORIGINS=https://drama.sdkwork.com,https://drama.birdcoder.com,https://drama.dtupay.com,https://drama.noaper.com,https://drama.sdkwork.cn,https://drama.birdcoder.cn,https://drama.dtupay.cn,https://drama.noaper.cn,https://drama.skubc.com,https://drama.skubc.cn,https://drama.zowalk.com,https://drama.zowalk.cn,https://drama.offer86.com,https://drama.offer86.cn,https://drama.86offer.com,https://drama.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
SDKWORK_DRAMA_HTTP_BIND=0.0.0.0:8090

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_SCHEMA=drama

# Production lifecycle: migrations run through the deploy pipeline only.
SDKWORK_DATABASE_AUTO_MIGRATE=0
