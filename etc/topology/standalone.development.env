# sdkwork-drama standalone.development profile
# Local loopback development values. No secrets; the database URL is a local
# placeholder override. Only variables actually consumed by the process are
# listed (see etc/README.md for the consumption map).

# IAM adapter environment detection + lifecycle development defaults.
SDKWORK_ENV=development
SDKWORK_ENVIRONMENT=development

# Standalone public application ingress (gateway bind).
SDKWORK_DRAMA_HTTP_BIND=127.0.0.1:8090

# Application database (local development instance; override locally).
SDKWORK_DATABASE_URL=postgres://sdkwork:sdkwork@127.0.0.1:5432/sdkwork_dev
SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_SCHEMA=drama

# Development lifecycle: apply drama and web-store migrations at boot.
SDKWORK_DATABASE_AUTO_MIGRATE=1

# Optional: web-framework `web_*` store module root. Unset resolves to the
# web-framework checkout next to this repository (source builds).
# SDKWORK_WEB_STORE_APP_ROOT=/path/to/sdkwork-web-framework

# Optional: deployable root owning `database/` lifecycle assets. Unset
# resolves to this repository root (source builds).
# SDKWORK_DRAMA_APP_ROOT=/path/to/sdkwork-drama
