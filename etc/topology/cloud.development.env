# sdkwork-drama cloud.development profile
# Explicit deployed cloud values; no loopback defaults are inherited from the
# standalone profile. Only variables actually consumed by the process are
# listed. Cloud database credentials are injected by the platform at runtime.

SDKWORK_ENV=development
SDKWORK_ENVIRONMENT=development

SDKWORK_DRAMA_HTTP_BIND=0.0.0.0:8090

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_SCHEMA=drama
SDKWORK_DATABASE_AUTO_MIGRATE=0
